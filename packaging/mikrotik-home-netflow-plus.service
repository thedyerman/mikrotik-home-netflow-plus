[Unit]
Description=Network traffic per connection and per device for MikroTik routers
Documentation=https://github.com/thedyerman/mikrotik-home-netflow-plus
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=mikrotik-home-netflow-plus
Group=mikrotik-home-netflow-plus
# Settings are NFP_* variables in this file. systemd reads it, so it can stay
# readable by root only.
EnvironmentFile=-/etc/mikrotik-home-netflow-plus/env
Environment=NFP_DATA_DIR=/var/lib/mikrotik-home-netflow-plus
ExecStart=/usr/bin/mikrotik-home-netflow-plus
Restart=on-failure
RestartSec=10s
# Pending data is written to the database on shutdown.
TimeoutStopSec=30s

# The binary is static and needs nothing but its data directory, so the rest
# of the system is hidden or read-only. Adding a drop-in with
# AmbientCapabilities=CAP_NET_BIND_SERVICE allows ports below 1024.
StateDirectory=mikrotik-home-netflow-plus
StateDirectoryMode=0750
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
