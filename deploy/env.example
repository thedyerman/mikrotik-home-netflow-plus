# Copy to .env (chmod 600) next to docker-compose.yml. Never commit the copy.

# The router that exports flows. Packets from any other address are dropped.
NFP_EXPORTERS=192.168.88.1

# Router API: adds second-by-second rates, device names and DNS names.
# Leave NFP_ROUTER_ADDR empty to run from flow records only.
NFP_ROUTER_ADDR=192.168.88.1
NFP_ROUTER_USER=flowmon
NFP_ROUTER_PASSWORD=change-me
# true  = api-ssl on 8729 (needs a certificate on the router; pinned on first use)
# false = plain api on 8728
NFP_ROUTER_TLS=true

# Optional: a friendlier name for a remote site than its tunnel interface name.
# NFP_SITES=office=192.168.99.0/24

# Optional: require a password for the web interface.
# NFP_AUTH_PASSWORD=

# Optional overrides (defaults shown).
# NFP_HTTP_LISTEN=:8080
# NFP_FLOW_LISTEN=:2055
# NFP_RETENTION_CONNECTIONS=48h
# NFP_RETENTION_1M=7d
# NFP_RETENTION_1H=30d
# NFP_FOLD_BELOW=10KB
# NFP_DB_MAX_SIZE=2GB
